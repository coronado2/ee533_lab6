#!/usr/bin/perl
use strict;
use warnings;

# ==============================
# Register Addresses
# ==============================

my $CPU_CMD   = 0x02000100;
my $CPU_ADDR  = 0x02000104;
my $CPU_WDATA = 0x02000108;
my $CPU_RDATA = 0x0200010C;

# ==============================
# Helper Functions
# ==============================

sub regwrite {
    my ($addr, $data) = @_;
    system(sprintf("nf2_regwrite 0x%08X 0x%08X", $addr, $data));
}

sub regread {
    my ($addr) = @_;
    my $output = `nf2_regread 0x@{[sprintf("%08X",$addr)]}`;
    print $output;
}

sub write_memory {
    my ($mem_addr, $data) = @_;
    print "\nWriting 0x" . sprintf("%08X",$data) . " to memory address $mem_addr\n";

    regwrite($CPU_ADDR,  $mem_addr);
    regwrite($CPU_WDATA, $data);
    regwrite($CPU_CMD,   0x1);   # bit0 = write
}

sub read_memory {
    my ($mem_addr) = @_;
    print "\nReading memory address $mem_addr\n";

    regwrite($CPU_ADDR, $mem_addr);
    regwrite($CPU_CMD,  0x2);    # bit1 = read
    regread($CPU_RDATA);
}

# ==============================
# Test Sequence
# ==============================

print "\n===== CPU Interface Test =====\n";

# Disable CPU before programming
print "\nDisabling CPU...\n";
regwrite($CPU_CMD, 0x0);

# --------------------------------
# Test Instruction Memory (0–511)
# --------------------------------
print "\n--- Testing Instruction Memory ---\n";

write_memory(0, 0x12345678);
write_memory(1, 0xDEADBEEF);

read_memory(0);
read_memory(1);

# --------------------------------
# Test Data Memory (512+)
# --------------------------------
print "\n--- Testing Data Memory ---\n";

# Address 512 = start of data memory in your map
write_memory(512, 0xAAAAAAAA);
write_memory(513, 0x55555555);

read_memory(512);
read_memory(513);

# --------------------------------
# Enable CPU
# --------------------------------
print "\nEnabling CPU...\n";
regwrite($CPU_CMD, 0x4);   # bit2 = cpu_enable

print "\nTest complete.\n";
