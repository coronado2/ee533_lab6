#!/usr/bin/perl -w
use strict;

# ==============================
# Register Addresses
# ==============================

my $CPU_CMD   = 0x2000100;
my $CPU_ADDR  = 0x2000104;
my $CPU_WDATA = 0x2000108;
my $CPU_RDATA = 0x200010c;

# ==============================
# Low-level Register Access
# ==============================

sub regwrite {
   my ($addr, $value) = @_;
   my $cmd = sprintf("regwrite 0x%x 0x%08x", $addr, $value);
   `$cmd`;
}

sub regread {
   my ($addr) = @_;
   my $cmd = sprintf("regread 0x%x", $addr);
   my @out = `$cmd`;
   my $result = $out[0];

   if ($result =~ m/0x([0-9a-fA-F]+)/) {
      return hex($1);
   }
   return 0;
}

# ==============================
# Memory Interface Helpers
# ==============================

sub write_mem {
   my ($addr, $data) = @_;

   regwrite($CPU_ADDR,  $addr);
   regwrite($CPU_WDATA, $data);
   regwrite($CPU_CMD,   0x1);     # bit0 = write

   # small delay to allow hardware to complete write
   select(undef, undef, undef, 0.01);
}

sub read_mem {
   my ($addr) = @_;

   regwrite($CPU_ADDR, $addr);
   regwrite($CPU_CMD,  0x2);      # bit1 = read

   # small delay to allow BRAM + register update
   select(undef, undef, undef, 0.01);

   return regread($CPU_RDATA);
}

sub print_result {
   my ($label, $expected, $actual) = @_;

   printf "%-45s Expected: 0x%08X   Read: 0x%08X\n",
          $label, $expected, $actual;

   if ($expected == $actual) {
      print "PASS\n\n";
   } else {
      print "FAIL\n\n";
   }
}

# ==============================
# Begin Test
# ==============================

print "\n===== CPU MEMORY INTERFACE VERIFICATION =====\n";

# Disable CPU before programming
regwrite($CPU_CMD, 0x0);

# ----------------------------
# Instruction Memory Test
# ----------------------------

print "\nTesting Instruction Memory (0-511)...\n";

my $i_addr = 10;
my $i_val  = 0x12345678;

write_mem($i_addr, $i_val);
my $read_i = read_mem($i_addr);

print_result("I-memory write/read at addr $i_addr",
             $i_val, $read_i);

# ----------------------------
# Data Memory Test
# ----------------------------

print "\nTesting Data Memory (512-768)...\n";

my $d_addr = 512 + 5;
my $d_val  = 0xAABBCCDD;

write_mem($d_addr, $d_val);
my $read_d = read_mem($d_addr);

print_result("D-memory write/read at addr $d_addr",
             $d_val, $read_d);

# ----------------------------
# Cross-Region Isolation Test
# ----------------------------

print "\nTesting Memory Isolation...\n";

my $check_i = read_mem($i_addr);
print_result("I-memory unchanged after D-memory write",
             $i_val, $check_i);

my $check_d = read_mem($d_addr);
print_result("D-memory unchanged after I-memory write",
             $d_val, $check_d);

print "\n===== TEST COMPLETE =====\n";
