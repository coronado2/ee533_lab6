<?xml version="1.0" encoding="UTF-8"?>
<nf:module xmlns:nf="http://www.NetFPGA.org/NF2_register_system"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.NetFPGA.org/NF2_register_system NF2_register_system.xsd">

  <nf:name>cpu</nf:name>
  <nf:prefix>cpu</nf:prefix>
  <nf:location>udp</nf:location>
  <nf:description>Registers for CPU module</nf:description>
  <nf:blocksize>16</nf:blocksize>

  <nf:registers>

    <nf:register>
      <nf:name>cpu_cmd</nf:name>
      <nf:description>CPU Command Register</nf:description>
      <nf:type>generic_software32</nf:type>
    </nf:register>

    <nf:register>
      <nf:name>cpu_addr</nf:name>
      <nf:description>CPU Memory Address Register</nf:description>
      <nf:type>generic_software32</nf:type>
    </nf:register>

    <nf:register>
      <nf:name>cpu_wdata</nf:name>
      <nf:description>CPU Memory Write Data</nf:description>
      <nf:type>generic_software32</nf:type>
    </nf:register>

    <nf:register>
      <nf:name>cpu_rdata</nf:name>
      <nf:description>CPU Memory Read Data</nf:description>
      <nf:type>generic_hardware32</nf:type>
    </nf:register>

  </nf:registers>

</nf:module>
